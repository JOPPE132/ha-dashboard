# Copy to .env.development.local and fill in.
# .env.development.local is only loaded by `npm run dev`, never by `npm run build`,
# so the token cannot end up in the deployed bundle.

# Where the dev server proxies /api to (HA runs on this same board).
HA_URL=http://localhost:8123

# Long-lived access token: HA -> Profile -> Security -> Long-lived access tokens -> Create token
VITE_HA_TOKEN=
